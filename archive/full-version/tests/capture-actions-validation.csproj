    <OutputPath>bin/capture-actions-validation/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="capture-actions-validation.cs" />
    <Compile Include="../src/ScreenNote/CaptureWindow.cs" Link="CaptureWindow.cs" /><Compile Include="../src/ScreenNote/CaptureWindow.EditTools.cs"/><Compile Include="../src/ScreenNote/WindowRegionDetector.cs"/>
    <Compile Include="../src/ScreenNote/AnnotationSurface.cs" Link="AnnotationSurface.cs" />
