<Project>
  <PropertyGroup>
    <BaseIntermediateOutputPath>obj/ui-history-flow/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <OutputPath>bin/ui-history-flow/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="ui-history-flow.cs" />
    <ProjectReference Include="../src/ScreenNote/ScreenNote.csproj" />
    <None Include="../src/ScreenNote/App.xaml" Link="test-resources.xaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
