<Project>
  <PropertyGroup>
    <BaseIntermediateOutputPath>obj/elevation-validation/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <OutputPath>bin/elevation-validation/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="elevation-validation.cs" />
    <Compile Include="../src/ScreenNote/ElevationService.cs" Link="ElevationService.cs" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
