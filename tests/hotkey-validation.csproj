<Project>
  <PropertyGroup>
    <BaseIntermediateOutputPath>obj/hotkey-validation/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <OutputPath>bin/hotkey-validation/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="hotkey-validation.cs" />
    <Compile Include="../src/ScreenNote/HotkeyService.cs" Link="HotkeyService.cs" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
