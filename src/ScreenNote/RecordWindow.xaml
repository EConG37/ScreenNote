<Window x:Class="ScreenNote.RecordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="拾屏 · 录制" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Topmost="True"
        PreviewKeyDown="Window_PreviewKeyDown">

  <Window.Resources>
    <Style x:Key="ModeCard" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Plate" CornerRadius="12" BorderThickness="1.5" BorderBrush="#E4E7DF"
                    Background="#FCFCFA" Padding="15,14">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Plate" Property="BorderBrush" Value="#C8CFC0" />
                <Setter TargetName="Plate" Property="Background" Value="#FDFDFB" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Plate" Property="BorderBrush" Value="#20231F" />
                <Setter TargetName="Plate" Property="Background" Value="#FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="QuietLink" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="Padding" Value="6,6" />
      <Setter Property="FontSize" Value="11" />
    </Style>
  </Window.Resources>

  <Border Margin="22" CornerRadius="16" Background="White" BorderBrush="#E1E4DD" BorderThickness="1"
          MouseLeftButtonDown="Surface_MouseLeftButtonDown">
    <Border.Effect>
      <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.16" Color="#20231F" />
    </Border.Effect>

    <StackPanel Margin="28,24,28,22">
      <!-- Header -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="录制" FontSize="20" FontWeight="SemiBold" />
          <TextBlock x:Name="Subtitle" Text="先选好区域，再开始。控制条不会出现在画面里。"
                     Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,0" />
        </StackPanel>
        <Button Grid.Column="1" Content="✕" Width="30" Height="30" Padding="0" FontSize="12"
                Background="Transparent" BorderThickness="0" Foreground="{StaticResource Muted}"
                ToolTip="关闭（Esc）" Click="Cancel_Click" VerticalAlignment="Top" />
      </Grid>

      <!-- Mode cards -->
      <UniformGrid Columns="2" Margin="-6,20,-6,0">
        <RadioButton x:Name="GifCard" GroupName="Mode" IsChecked="True" Style="{StaticResource ModeCard}"
                     Margin="6" Checked="Mode_Checked" AutomationProperties.Name="录制 GIF">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="44" Height="44" CornerRadius="12" Background="#EDF1E6" VerticalAlignment="Top">
              <TextBlock Text="GIF" FontSize="11" FontWeight="SemiBold" Foreground="#4E5B43"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="13,1,0,0">
              <TextBlock Text="录制 GIF" FontSize="14" FontWeight="SemiBold" />
              <TextBlock Text="体积小，微信里可直接发送和预览" TextWrapping="Wrap" LineHeight="17"
                         FontSize="11" Foreground="{StaticResource Muted}" Margin="0,6,0,0" />
              <TextBlock Text="最长 60 秒" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>
          </Grid>
        </RadioButton>

        <RadioButton x:Name="VideoCard" GroupName="Mode" Style="{StaticResource ModeCard}"
                     Margin="6" Checked="Mode_Checked" AutomationProperties.Name="录制视频">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="44" Height="44" CornerRadius="12" Background="#EDF1E6" VerticalAlignment="Top">
              <Path Data="M 0 0 L 13 7.5 L 0 15 Z" Fill="#4E5B43" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Stretch="None" />
            </Border>
            <StackPanel Grid.Column="1" Margin="13,1,0,0">
              <TextBlock Text="录制视频" FontSize="14" FontWeight="SemiBold" />
              <TextBlock Text="MP4 高清画面，适合演示和长一点的操作" TextWrapping="Wrap" LineHeight="17"
                         FontSize="11" Foreground="{StaticResource Muted}" Margin="0,6,0,0" />
              <TextBlock Text="最长 10 分钟 · 不含声音" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>
          </Grid>
        </RadioButton>
      </UniformGrid>

      <!-- Settings -->
      <Border Background="#FAFBF7" BorderBrush="#EDEFE7" BorderThickness="1" CornerRadius="10"
              Padding="16,12" Margin="0,16,0,0">
        <Grid>
          <StackPanel x:Name="GifSettings" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="帧率" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
            <ComboBox x:Name="GifFps" Width="104" Margin="8,0,20,0" SelectedIndex="1"
                      SelectionChanged="Settings_Changed">
              <ComboBoxItem Content="10 帧/秒" Tag="10" />
              <ComboBoxItem Content="15 帧/秒" Tag="15" />
              <ComboBoxItem Content="20 帧/秒" Tag="20" />
            </ComboBox>
            <TextBlock Text="体积" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
            <ComboBox x:Name="GifTarget" Width="196" Margin="8,0,0,0" SelectedIndex="0"
                      SelectionChanged="Settings_Changed">
              <ComboBoxItem Content="微信直发（10 MB 以内）" Tag="wechat" />
              <ComboBoxItem Content="保留原始体积" Tag="raw" />
            </ComboBox>
          </StackPanel>

          <StackPanel x:Name="VideoSettings" Orientation="Horizontal" VerticalAlignment="Center"
                      Visibility="Collapsed">
            <TextBlock Text="帧率" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
            <ComboBox x:Name="VideoFps" Width="104" Margin="8,0,20,0" SelectedIndex="1"
                      SelectionChanged="Settings_Changed">
              <ComboBoxItem Content="24 帧/秒" Tag="24" />
              <ComboBoxItem Content="30 帧/秒" Tag="30" />
              <ComboBoxItem Content="60 帧/秒" Tag="60" />
            </ComboBox>
            <TextBlock Text="编码" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
            <TextBlock Text="Windows 自带 H.264 · 分辨率随选区" FontSize="11" VerticalAlignment="Center"
                       Margin="8,0,0,0" />
          </StackPanel>
        </Grid>
      </Border>

      <TextBlock x:Name="Hint" Text="下一步：在屏幕上拖出要录制的区域，松手后倒计时 3 秒开始。"
                 FontSize="11" Foreground="{StaticResource Muted}" Margin="0,14,0,0" TextWrapping="Wrap" />

      <!-- Footer -->
      <DockPanel Margin="0,18,0,0" LastChildFill="False">
        <Button DockPanel.Dock="Left" Style="{StaticResource QuietLink}" Content="压缩已有 GIF…"
                Click="CompressExisting_Click" ToolTip="打开一个 GIF，裁剪或压到 10 MB 以内" />
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="取消" Click="Cancel_Click" Margin="0,0,8,0" Padding="18,9" />
          <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Content="选择区域并开始"
                  Click="Start_Click" Padding="20,9" IsDefault="True" />
        </StackPanel>
      </DockPanel>
    </StackPanel>
  </Border>
</Window>