<Window x:Class="ScreenNote.RecordingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="拾屏 · 录制中" Width="470" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Topmost="True"
        PreviewKeyDown="Window_PreviewKeyDown">

  <Border Margin="20" CornerRadius="16" Background="White" BorderBrush="#E1E4DD" BorderThickness="1"
          MouseLeftButtonDown="Surface_MouseLeftButtonDown">
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="7" Direction="270" Opacity="0.16" Color="#20231F" />
    </Border.Effect>

    <StackPanel Margin="26,22,26,20">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="LiveDot" Width="8" Height="8" Fill="#C4453A" Margin="0,0,8,0"
                     VerticalAlignment="Center" Visibility="Collapsed" />
            <TextBlock x:Name="HeadingText" Text="3 秒后开始录制" FontSize="15" FontWeight="SemiBold" />
          </StackPanel>
          <TextBlock x:Name="RegionText" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,0" />
        </StackPanel>
        <Button Grid.Column="1" Content="✕" Width="30" Height="30" Padding="0" FontSize="12"
                Background="Transparent" BorderThickness="0" Foreground="{StaticResource Muted}"
                ToolTip="取消（Esc）" Click="Cancel_Click" VerticalAlignment="Top" />
      </Grid>

      <TextBlock x:Name="BigText" Text="3" FontSize="46" FontWeight="SemiBold" Margin="0,16,0,0" />

      <ProgressBar x:Name="Progress" Height="3" Margin="0,10,0,0" Minimum="0" Maximum="1" Value="0"
                   Foreground="#20231F" Background="#E9ECE4" BorderThickness="0" />

      <TextBlock x:Name="StatusText" Text="请切换到要演示的窗口。" TextWrapping="Wrap" LineHeight="19"
                 FontSize="11" Foreground="{StaticResource Muted}" Margin="0,12,0,0" />

      <DockPanel Margin="0,18,0,0" LastChildFill="False">
        <Button DockPanel.Dock="Right" x:Name="PrimaryButton" Style="{StaticResource PrimaryButton}"
                Content="停止并保存" Click="Primary_Click" Padding="20,9" />
        <Button x:Name="CancelButton" Content="取消" Click="Cancel_Click" Margin="0,0,8,0" Padding="18,9" />
        <TextBlock x:Name="FootNote" Text="控制条已从画面中排除" FontSize="10" Foreground="{StaticResource Muted}"
                   VerticalAlignment="Center" Margin="12,0,0,0" />
      </DockPanel>
    </StackPanel>
  </Border>
</Window>