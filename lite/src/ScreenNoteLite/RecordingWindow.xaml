<Window x:Class="ScreenNote.RecordingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScreenNote"
        Style="{StaticResource {x:Type Window}}"
        Title="拾屏 · 录制" Width="410" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="Manual" ShowInTaskbar="False" Topmost="True"
        PreviewKeyDown="Window_PreviewKeyDown">

  <Border Margin="10" CornerRadius="16" Background="{StaticResource Canvas}" BorderBrush="{StaticResource Line}" BorderThickness="1"
          MouseLeftButtonDown="Surface_MouseLeftButtonDown">
    <Border.Effect>
      <DropShadowEffect BlurRadius="18" ShadowDepth="5" Direction="270" Opacity="0.14" Color="#65749A" />
    </Border.Effect>

    <StackPanel Margin="14,11,14,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Ellipse x:Name="LiveDot" Width="7" Height="7" Fill="#C4453A" Margin="0,0,7,0"
                 VerticalAlignment="Center" Visibility="Collapsed" />
        <TextBlock x:Name="HeadingText" Grid.Column="1" Text="准备录制" FontSize="14" FontWeight="SemiBold"
                   VerticalAlignment="Center" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="ClockText" Text="0:00" FontSize="14" Foreground="{StaticResource Muted}"
                     FontFamily="Consolas" Margin="0,0,4,0" VerticalAlignment="Center" />
          <Button Width="28" Height="28" Padding="0" FontSize="13" Background="Transparent"
                  BorderThickness="0" Foreground="{StaticResource Muted}" ToolTip="放弃本次录制（Esc）"
                  Click="Cancel_Click" AutomationProperties.Name="放弃本次录制"><local:ToolGlyph Kind="close" Width="16" Height="16" Foreground="{StaticResource Muted}"/></Button>
        </StackPanel>
      </Grid>

      <TextBlock x:Name="RegionText" Text="" Foreground="{StaticResource Muted}" FontSize="13"
                 Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />

      <ProgressBar x:Name="Progress" Height="3" Margin="0,10,0,0" Minimum="0" Maximum="1" Value="0"
                   Foreground="{StaticResource Accent}" Background="{StaticResource AccentSoft}" BorderThickness="0" />

      <DockPanel Margin="0,11,0,0" LastChildFill="False">
        <Button DockPanel.Dock="Right" x:Name="PrimaryButton" Style="{StaticResource PrimaryButton}"
                Content="停止并保存" Click="Primary_Click" Padding="12,8" FontSize="13" IsEnabled="False" />
        <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Content="开始录制" Click="Start_Click" Padding="12,8" FontSize="13" />
        <Button x:Name="PauseButton" Content="暂停" Click="Pause_Click" Padding="10,8" FontSize="13"
                Margin="8,0,0,0" Visibility="Collapsed" />
        <Button x:Name="CancelButton" Content="放弃" Click="Cancel_Click" Padding="10,8" FontSize="13"
                Margin="8,0,0,0" Background="Transparent" BorderBrush="Transparent"
                Foreground="{StaticResource Muted}" />
      </DockPanel>

      <TextBlock x:Name="FootNote" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,7,0,0"
                 TextWrapping="Wrap" Visibility="Collapsed" />
    </StackPanel>
  </Border>
</Window>
