<Window x:Class="ScreenNote.RecordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ScreenNote"
        Style="{StaticResource {x:Type Window}}"
        Title="拾屏 · 录制" Width="740" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Topmost="True"
        PreviewKeyDown="Window_PreviewKeyDown">

  <Window.Resources>
    <Style x:Key="ModeCard" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Plate" CornerRadius="16" BorderThickness="1.5" BorderBrush="{StaticResource Line}"
                    Background="{StaticResource Surface}" Padding="15,14">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Plate" Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter TargetName="Plate" Property="Background" Value="{StaticResource Surface}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Plate" Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter TargetName="Plate" Property="Background" Value="{StaticResource AccentSoft}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="QuietLink" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="Padding" Value="6,6" />
      <Setter Property="FontSize" Value="13" />
    </Style>
  </Window.Resources>

  <Border Margin="22" CornerRadius="16" Background="{StaticResource Canvas}" BorderBrush="{StaticResource Line}" BorderThickness="1"
          MouseLeftButtonDown="Surface_MouseLeftButtonDown">
    <Border.Effect>
      <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.16" Color="#65749A" />
    </Border.Effect>

    <StackPanel Margin="28,24,28,22">
      <!-- Header -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="录制" FontSize="24" FontWeight="SemiBold" />
          <TextBlock x:Name="Subtitle" Text="先选好区域，再在控制条开始录制。"
                     Foreground="{StaticResource Muted}" FontSize="13" Margin="0,7,0,0" />
        </StackPanel>
        <Button Grid.Column="1" Width="32" Height="32" Padding="0" FontSize="13"
                Background="Transparent" BorderThickness="0" Foreground="{StaticResource Muted}"
                ToolTip="关闭（Esc）" Click="Cancel_Click" VerticalAlignment="Top" AutomationProperties.Name="关闭录制准备">
          <local:ToolGlyph Kind="close" Foreground="{StaticResource Muted}" Width="18" Height="18" />
        </Button>
      </Grid>

      <!-- Mode cards -->
      <UniformGrid Columns="2" Margin="-6,20,-6,0">
        <RadioButton x:Name="GifCard" GroupName="Mode" IsChecked="True" Style="{StaticResource ModeCard}"
                     Margin="6" Checked="Mode_Checked" AutomationProperties.Name="录制 GIF">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource AccentSoft}" VerticalAlignment="Top">
              <local:ToolGlyph Kind="record" Width="26" Height="26" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="13,1,0,0">
              <TextBlock Text="录制 GIF" FontSize="14" FontWeight="SemiBold" />
              <TextBlock Text="体积小，微信里可直接发送和预览" TextWrapping="Wrap" LineHeight="20"
                         FontSize="13" Foreground="{StaticResource Muted}" Margin="0,6,0,0" />
              <TextBlock Text="最长 60 秒" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>
          </Grid>
        </RadioButton>

        <RadioButton x:Name="VideoCard" GroupName="Mode" Style="{StaticResource ModeCard}"
                     Margin="6" Checked="Mode_Checked" AutomationProperties.Name="录制视频">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource AccentSoft}" VerticalAlignment="Top">
              <local:ToolGlyph Kind="video" Width="26" Height="26" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="13,1,0,0">
              <TextBlock Text="录制视频" FontSize="14" FontWeight="SemiBold" />
              <TextBlock Text="MP4 高清画面，适合演示和长一点的操作" TextWrapping="Wrap" LineHeight="20"
                         FontSize="13" Foreground="{StaticResource Muted}" Margin="0,6,0,0" />
              <TextBlock Text="最长 10 分钟 · 可带声音" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
            </StackPanel>
          </Grid>
        </RadioButton>
      </UniformGrid>

      <!-- Settings -->
      <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16"
              Padding="18,16" Margin="0,16,0,0">
        <Grid>
          <StackPanel x:Name="GifSettings" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="帧率" FontSize="13" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
            <ComboBox x:Name="GifFps" Width="104" Margin="8,0,20,0" SelectedIndex="1"
                      SelectionChanged="Settings_Changed">
              <ComboBoxItem Content="10 帧/秒" Tag="10" />
              <ComboBoxItem Content="15 帧/秒" Tag="15" />
              <ComboBoxItem Content="20 帧/秒" Tag="20" />
            </ComboBox>
            <TextBlock Text="体积" FontSize="13" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
            <ComboBox x:Name="GifTarget" Width="196" Margin="8,0,0,0" SelectedIndex="0"
                      SelectionChanged="Settings_Changed">
              <ComboBoxItem Content="微信直发（10 MB 以内）" Tag="wechat" />
              <ComboBoxItem Content="保留原始体积" Tag="raw" />
            </ComboBox>
          </StackPanel>

          <StackPanel x:Name="VideoSettings" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="帧率" FontSize="13" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
              <ComboBox x:Name="VideoFps" Width="104" Margin="8,0,20,0" SelectedIndex="1"
                        SelectionChanged="Settings_Changed">
                <ComboBoxItem Content="24 帧/秒" Tag="24" />
                <ComboBoxItem Content="30 帧/秒" Tag="30" />
                <ComboBoxItem Content="60 帧/秒" Tag="60" />
              </ComboBox>
              <TextBlock Text="编码" FontSize="13" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
              <TextBlock Text="H.264 · 分辨率随选区" FontSize="13" VerticalAlignment="Center"
                         Margin="8,0,0,0" />
            </StackPanel>
            <WrapPanel Margin="0,10,0,0">
              <TextBlock Text="声音" FontSize="13" Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                         Margin="0,0,8,0" />
              <CheckBox x:Name="SystemSoundBox" Content="系统声音" IsChecked="True" VerticalAlignment="Center"
                        Click="Sound_Changed" />
              <CheckBox x:Name="MicrophoneBox" Content="麦克风" VerticalAlignment="Center" Margin="16,0,0,0"
                        Click="Sound_Changed" />
              <TextBlock x:Name="SoundNote" FontSize="13" Foreground="{StaticResource Muted}"
                         VerticalAlignment="Center" Margin="0,10,0,0" Width="560" TextWrapping="Wrap" />
            </WrapPanel>
          </StackPanel>
        </Grid>
      </Border>

      <TextBlock x:Name="Hint" Text="拖出录制区域，再在控制条点击「开始录制」。"
                 FontSize="13" Foreground="{StaticResource Muted}" Margin="0,14,0,0" TextWrapping="Wrap" />

      <!-- Footer -->
      <DockPanel Margin="0,18,0,0" LastChildFill="False">
        <Button DockPanel.Dock="Left" Style="{StaticResource QuietLink}" Click="CompressExisting_Click" ToolTip="打开一个 GIF，裁剪或压到 10 MB 以内"><StackPanel Orientation="Horizontal"><local:ToolGlyph Kind="trim" Width="18" Height="18" Margin="0,0,7,0" Foreground="{StaticResource Muted}"/><TextBlock Text="压缩已有 GIF…" VerticalAlignment="Center"/></StackPanel></Button>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="取消" Click="Cancel_Click" Margin="0,0,8,0" Padding="18,9" />
          <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Content="选择录制区域"
                  Click="Start_Click" Padding="20,9" IsDefault="True" />
        </StackPanel>
      </DockPanel>
    </StackPanel>
  </Border>
</Window>
